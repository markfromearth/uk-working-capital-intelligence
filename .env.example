# UK Working-Capital Intelligence & Prospect Scoring Platform
# Environment Configuration Template (Safe Non-Secret Defaults)

PROJECT_NAME="UK Working-Capital Intelligence Platform"
ENVIRONMENT=development
LOG_LEVEL=INFO
# Generate with: openssl rand -hex 32 (MUST be >=32 chars in production/staging)
SECRET_KEY=
AUDIT_CHECKPOINT_SECRET=

# Optional First-Administrator Bootstrap (Leave empty unless bootstrapping an initial account)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_ROLE=admin

# Relational Database URL (SQLite for local/test, PostgreSQL for scalable production)
DATABASE_URL=sqlite:///./working_capital.db

# Live Provider Credentials
COMPANIES_HOUSE_API_KEY=
CREDITSAFE_API_KEY=
CREDITSAFE_WEBHOOK_SECRET=
EXPERIAN_API_KEY=
PROXYCURL_API_KEY=
ANTHROPIC_API_KEY=

# Operational Switches (DEMO_MODE must be false in staging/production)
DEMO_MODE=false
ENABLE_DEAD_LETTER_QUEUE=true
MAX_RETRY_ATTEMPTS=3
RATE_LIMIT_PER_MINUTE=120
