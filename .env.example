# UK Working-Capital Intelligence & Prospect Scoring Platform
# Environment Configuration Template

PROJECT_NAME="UK Working-Capital Intelligence Platform"
ENVIRONMENT=production
LOG_LEVEL=INFO
SECRET_KEY=replace-with-a-cryptographically-secure-random-key-in-production

# Relational Database URL (SQLite for local/test, PostgreSQL for scalable production)
# Example PostgreSQL: postgresql+psycopg2://capital_user:capital_pass@localhost:5432/working_capital
DATABASE_URL=sqlite:///./working_capital.db

# Live Provider Credentials (Leave empty to activate verified deterministic simulation fixtures)
COMPANIES_HOUSE_API_KEY=
CREDITSAFE_API_KEY=
CREDITSAFE_WEBHOOK_SECRET=
EXPERIAN_API_KEY=
PROXYCURL_API_KEY=
ANTHROPIC_API_KEY=

# Operational Switches
DEMO_MODE=true
ENABLE_DEAD_LETTER_QUEUE=true
MAX_RETRY_ATTEMPTS=3
RATE_LIMIT_PER_MINUTE=120
